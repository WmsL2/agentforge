# PUBLIC TEMPLATE ONLY; never use unchanged. No production secrets are provided.
# Copy manually to private .env.prod; this task never creates that file.
# Use single-quoted dotenv values for credentials containing $, #, spaces, etc.
# Compose shell variables override --env-file values; shared environment mappings
# deliberately propagate that same resolved value to infra and all backend roles.
# Deployment Make inputs (set explicitly on command line, not secrets):
# PROD_PROJECT=agentforge-prod-<unique-lowercase-id>; RELEASE_ID=<unique-release>
# Images: agentforge/<PROD_PROJECT>-backend:<RELEASE_ID> and -frontend:<RELEASE_ID>.
# prod validates Settings in an ephemeral no-deps/no-pull migrate image before
# stopping existing roles; no credentials/Settings dump is printed.
# PROD_ENV_FILE defaults to backend/.env.prod; private .env.prod.<id> is supported.
# Explicit compatible base/infra refs REQUIRED; select verified immutable digests.
# No digest is supplied or resolved by this template. Keep Python 3.12, Debian
# slim runtime conventions, Bun Debian useradd support, PG16/pgvector 0.8.7, Redis7.
PYTHON_IMAGE=
UV_IMAGE=
BUN_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
API_BIND_HOST=127.0.0.1
API_HOST_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_HOST_PORT=3000
FLOWER_BIND_HOST=127.0.0.1
FLOWER_HOST_PORT=5555
# Public browser build inputs only; use approved HTTPS/WSS origins behind TLS.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECURE=true
ENVIRONMENT=production
DEBUG=false
DB_ECHO=false
SECRET_KEY=
API_KEY=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
FLOWER_USER=
# Flower user/password cannot contain colon/comma; user also cannot contain whitespace.
FLOWER_PASSWORD=
CORS_ORIGINS=[]

# Optional capabilities: empty keys mean unavailable, not connected/operational.
# Full-platform staging needs both LLM and Embedding configurations.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
AI_MODEL=gpt-5.5
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_AGENT_ENABLED=false
# Legacy template chat only; never substitutes for LLM_API_KEY.
OPENAI_API_KEY=
# Omit CELERY_BROKER_URL / CELERY_RESULT_BACKEND: production derives both.
# No AGENTFORGE_ENV_FILE path inside containers: explicit env injection only.
